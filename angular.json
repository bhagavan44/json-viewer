{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "json-viewer": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": false
        },
        "@schematics/angular:directive": {
          "standalone": false
        },
        "@schematics/angular:pipe": {
          "standalone": false
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "node_modules/monaco-editor/min/vs",
                "output": "vs",
                "ignore": [
                  "{abap,apex,azcli,bat,bicep,cameligo,clojure,coffee,cpp,csharp,csp,css,cypher,dart,dockerfile,ecl,elixir,flow9,freemarker2,fsharp,go,graphql,handlebars,hcl,html,ini,java,javascript,julia,kotlin,less,lexon,liquid,lua,m3,markdown,mdx,mips,msdax,mysql,objective-c,pascal,pascaligo,perl,pgsql,php,pla,postiats,powerquery,powershell,protobuf,pug,python,qsharp,r,razor,redis,redshift,restructuredtext,ruby,rust,sb,scala,scheme,scss,shell,solidity,sophia,sparql,sql,st,swift,systemverilog,tcl,twig,typescript,typespec,vb,wgsl,xml,yaml,cssMode,htmlMode,tsMode}-*.js",
                  "assets/{ts,css,html}.worker-*.js",
                  "language/{typescript/ts,css/css,html/html}.worker.js",
                  "nls/lang/**"
                ]
              }
            ],
            "styles": [
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "24kB"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": true
              },
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "json-viewer:build:production"
            },
            "development": {
              "buildTarget": "json-viewer:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "setupFiles": ["src/test-setup.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
